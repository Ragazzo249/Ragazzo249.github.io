---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/site';
---

<Base title="ページが見つかりません">
  <section class="sec tone-light">
    <div class="container sec-inner">
      <p class="sec-label">迷子</p>
      <div>
        <h1 class="display">Not<br />found.</h1>
        <p class="mincho">お探しのページは見つかりませんでした。</p>
        <p class="label"><a href={withBase('/')}>← Back to top</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  section {
    padding: 120px 0 160px;
  }

  h1 {
    margin: 0 0 48px;
    font-size: clamp(56px, 15vw, 200px);
  }

  .label a {
    text-decoration: none;
  }
</style>
