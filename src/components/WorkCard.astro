---
import type { CollectionEntry } from 'astro:content';
import { formatStamp, withBase } from '../lib/site';

interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, statement, summary, started, status, tags } = work.data;
---

<article class="row" data-reveal>
  <p class="meta label">
    <span>WORK_{formatStamp(started)}</span>
    <span class="status" data-status={status}>{status}</span>
  </p>
  <h3 class="display">
    <a href={withBase(`/works/${work.id}/`)}>{title}</a>
  </h3>
  {statement && <p class="statement">{statement}</p>}
  <p class="summary mincho">{summary}</p>
  <ul class="tags">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <span class="arrow display" aria-hidden="true">→</span>
</article>

<style>
  .row {
    position: relative;
    display: grid;
    gap: 14px;
    padding: 40px 0 44px;
    border-top: 1px solid var(--rule);
  }

  .row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .meta {
    display: flex;
    gap: 24px;
    margin: 0;
    color: var(--sub);
  }

  h3 {
    margin: 0;
    font-size: clamp(44px, 9vw, 112px);
  }

  /* 行全体をクリックできるようにする */
  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .statement {
    margin: 0;
    color: var(--sub);
    font-family: var(--font-display);
    font-size: clamp(18px, 2.4vw, 26px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .summary {
    max-width: 34em;
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 2.1;
  }

  .arrow {
    position: absolute;
    top: 40px;
    right: 0;
    font-size: clamp(28px, 4vw, 44px);
    transition: transform 0.6s var(--ease-out);
  }

  .row:hover .arrow,
  .row:focus-within .arrow {
    transform: translateX(10px);
  }

  .row:focus-within h3 a {
    text-decoration: underline;
    text-decoration-thickness: 4px;
    text-underline-offset: 8px;
  }

  h3 a:focus-visible {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow {
      transition: none;
    }
  }
</style>
