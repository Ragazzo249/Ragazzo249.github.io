---
// 作品ごとのカバー模様。スクリーンショットがなくても一覧が寂しくならないよう、
// 作品 ID から決まる乱数でブロック状の模様を描く(同じ ID なら毎回同じ模様)。
interface Props {
  seed: string;
  accent: string;
  cols?: number;
  rows?: number;
}

const { seed, accent, cols = 12, rows = 5 } = Astro.props;

function hash(text: string): number {
  let h = 2166136261;
  for (const ch of text) {
    h ^= ch.codePointAt(0)!;
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

// mulberry32
function rng(seedValue: number) {
  let a = seedValue;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = rng(hash(seed));
// 地層のように、上の段ほど薄く、下ほど濃くする
const mixes = [18, 32, 48, 66, 85];
const cells = Array.from({ length: rows * cols }, (_, i) => {
  const row = Math.floor(i / cols);
  const base = mixes[Math.min(row, mixes.length - 1)];
  const jitter = Math.floor(rand() * 3) - 1;
  const level = mixes[Math.max(0, Math.min(mixes.length - 1, mixes.indexOf(base) + jitter))];
  return { x: i % cols, y: row, level };
});
---

<svg
  class="cover"
  viewBox={`0 0 ${cols} ${rows}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  style={`--accent: ${accent}`}
>
  {
    cells.map((c) => (
      <rect
        x={c.x}
        y={c.y}
        width="1"
        height="1"
        style={`fill: color-mix(in oklab, var(--accent) ${c.level}%, var(--surface))`}
      />
    ))
  }
</svg>

<style>
  .cover {
    display: block;
    width: 100%;
    height: 100%;
    shape-rendering: crispEdges;
  }
</style>
