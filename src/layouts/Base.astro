---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { SITE, withBase } from '../lib/site';
import { frontmatter as aboutFrontmatter } from '../content/about.md';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const works = await getCollection('works', ({ data }) => !data.draft);
// 自己紹介が下書きの間は、ナビにも出さない
const aboutDraft = Boolean(aboutFrontmatter.draft);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;700;900&family=Zen+Kaku+Gothic+New:wght@400;700&family=Zen+Old+Mincho:wght@400;700&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {
      /* Cloudflare Web Analytics。開発中のアクセスを数えないよう本番ビルドだけに入れる */
      import.meta.env.PROD && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.cfBeaconToken })}
        />
      )
    }
  </head>
  <body>
    <div class="guides" aria-hidden="true">
      <div class="container"><span></span><span></span><span></span><span></span></div>
    </div>

    <header class="site-header tone-light">
      <div class="container inner">
        <a class="brand display" href={withBase('/')}>{SITE.title}</a>
        <nav class="label">
          {!aboutDraft && <a href={withBase('/#about')}>About</a>}
          <a href={withBase('/#works')}>Works</a>
          <a href={SITE.github} rel="me">GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer tone-dark">
      <div class="container">
        <div class="cols">
          <div>
            <p class="label">Works</p>
            <ul>
              {
                works.map((work) => (
                  <li>
                    <a href={withBase(`/works/${work.id}/`)}>{work.data.title}</a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <p class="label">Elsewhere</p>
            <ul>
              <li><a href={SITE.github} rel="me">GitHub ↗</a></li>
            </ul>
          </div>
        </div>
        <p class="copy label">© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>

    <script>
      // [data-reveal] が画面に入ったら .is-in を付ける(一度だけ)
      const targets = document.querySelectorAll('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      targets.forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 72px;
  }

  .brand {
    font-size: 20px;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .site-footer {
    padding: 96px 0 32px;
    border-top: 1px solid var(--rule);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  @media (min-width: 820px) {
    .cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .cols .label {
    margin: 0 0 12px;
    color: var(--sub);
  }

  .cols ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mincho);
  }

  .cols a {
    text-decoration: none;
  }

  .cols a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .copy {
    margin: 96px 0 0;
    color: var(--sub);
  }
</style>
